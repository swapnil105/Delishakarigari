<script>
  if (window.location.pathname.endsWith('/collections/all') || window.location.pathname.endsWith('/collections/all/')) {
    window.location.replace('/collections');
  }
</script>
<div class="list-collections-section" style="background-color: #fdfaf5; padding-top: 50px; padding-bottom: 60px;">
  <div class="lc-container">
    
    <!-- Breadcrumb -->
    <nav class="lc-breadcrumb" aria-label="breadcrumbs">
      <a href="{{ routes.root_url }}" title="Home">Home</a>
      <span aria-hidden="true">&rsaquo;</span>
      <span>Our Collections</span>
    </nav>

    <!-- Header -->
    <div class="lc-header" style="text-align: center;">
      <h1 class="lc-page-title" style="color: #111111;">Our Collections</h1>
      <p class="lc-page-subtext" style="color: #111111; opacity: 0.8;">Explore our handcrafted categories.</p>
    </div>

    <!-- Grid -->
    {% paginate collections by 50 %}
    <div class="lc-grid columns-3">
      {% assign visible_collections_count = 0 %}
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          {% assign visible_collections_count = visible_collections_count | plus: 1 %}
          <div class="lc-item">
            <div class="lc-card-image-wrap" style="aspect-ratio: 1 / 1;">
              {% if collection.image %}
                <img src="{{ collection.image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" class="lc-card-image" loading="lazy" width="600" height="600">
              {% elsif collection.products.first and collection.products.first.featured_image %}
                <img src="{{ collection.products.first.featured_image | image_url: width: 600 }}" alt="{{ collection.title | escape }}" class="lc-card-image" loading="lazy" width="600" height="600">
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'lc-placeholder-svg' }}
              {% endif %}
              
              <div class="lc-card-overlay" style="background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0) 60%);">
                <h3 class="lc-card-title">{{ collection.title }}</h3>
                <span class="lc-btn">EXPLORE</span>
              </div>
              <a href="{{ collection.url }}" class="lc-card-link" aria-label="Explore {{ collection.title }}"></a>
            </div>
          </div>
        {% endunless %}
      {% endfor %}

      {% if visible_collections_count == 0 %}
        {%- comment -%} CURATED BRAND COLLECTIONS SHOWCASE {%- endcomment -%}
        {%- assign cur_titles = "Royal Pearl Rakhi Collection|Nazariya Collection|Blessed Collection|Festive Rakhi Collection|Bhaiya Bhabhi & Lumba Sets|Rakhi Hampers & Trios" | split: "|" -%}
        {%- assign cur_counts = "9 Handcrafted Pieces|5 Protective Designs|6 Sacred Designs|4 Festive Pairs|Coordinated Sets|Complete Hampers" | split: "|" -%}
        {%- assign cur_imgs = "dk-cat-royal-pearl.jpg|dk-cat-nazariya.jpg|dk-cat-blessed.jpg|dk-cat-festive.jpg|dk-cat-bhaiya-bhabhi.jpg|dk-cat-sets.jpg" | split: "|" -%}
        {%- assign cur_urls = "/collections/royal-pearl-rakhi-collection|/collections/nazariya-collection|/collections/blessed-collection|/collections/festive-rakhi-collection|/collections/bhaiya-bhabhi|/collections/all" | split: "|" -%}

        {%- for i in (0..5) -%}
          {%- assign c_title = cur_titles[i] -%}
          {%- assign c_count = cur_counts[i] -%}
          {%- assign c_img = cur_imgs[i] -%}
          {%- assign c_url = cur_urls[i] -%}

          <div class="lc-item">
            <div class="lc-card-image-wrap" style="aspect-ratio: 1 / 1;">
              <img src="{{ c_img | asset_url }}" alt="{{ c_title | escape }}" class="lc-card-image" loading="lazy" width="600" height="600">
              <div class="lc-card-overlay" style="background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.1) 60%);">
                <h3 class="lc-card-title">{{ c_title }}</h3>
                <p style="color: rgba(255,255,255,0.85); font-size: 13px; margin: 0 0 12px 0;">{{ c_count }}</p>
                <span class="lc-btn">EXPLORE</span>
              </div>
              <a href="{{ c_url }}" class="lc-card-link" aria-label="Explore {{ c_title }}"></a>
            </div>
          </div>
        {%- endfor -%}
      {% endif %}
    </div>
    {% endpaginate %}

  </div>
</div>

<style>
.list-collections-section {
  font-family: var(--font-body, sans-serif);
}
.lc-container {
  width: 90%;
  max-width: 1400px;
  margin: 0 auto;
}

/* Breadcrumbs */
.lc-breadcrumb {
  font-size: 13px;
  color: #666;
  margin-bottom: 20px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.lc-breadcrumb a {
  color: #333;
  text-decoration: none;
  font-weight: 500;
  transition: color 0.2s;
}
.lc-breadcrumb a:hover {
  color: #d8a85e;
}

/* Header */
.lc-header {
  margin-bottom: 50px;
}
.lc-page-title {
  font-family: 'Playfair Display', serif;
  font-size: 40px;
  margin: 0 0 10px 0;
  letter-spacing: 2px;
}
.lc-page-subtext {
  font-size: 16px;
  max-width: 600px;
  margin: 0 auto;
}

/* Grid */
.lc-grid {
  display: grid;
  gap: 30px;
  grid-template-columns: repeat(3, 1fr);
}

/* Card */
.lc-item {
  position: relative;
  overflow: hidden;
  border-radius: 12px;
  box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  transition: transform 0.4s ease, box-shadow 0.4s ease;
}
.lc-item:hover {
  transform: translateY(-8px);
  box-shadow: 0 15px 40px rgba(0,0,0,0.15);
}
.lc-card-link {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 10;
  display: block;
  text-decoration: none;
  color: inherit;
}
.lc-card-image-wrap {
  position: relative;
  width: 100%;
  overflow: hidden;
  background: #fdfdfd;
}
.lc-card-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s ease;
}
.lc-placeholder-svg {
  width: 100%;
  height: 100%;
  background-color: #f0f0f0;
  fill: #ccc;
  object-fit: cover;
  transition: transform 0.8s ease;
}
.lc-item:hover .lc-card-image,
.lc-item:hover .lc-placeholder-svg {
  transform: scale(1.08);
}

/* Overlay & Text */
.lc-card-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 30px 20px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  text-align: center;
  z-index: 2;
}
.lc-card-title {
  color: #fff;
  font-family: 'Playfair Display', serif;
  font-size: 26px;
  margin: 0 0 15px 0;
  letter-spacing: 1px;
}
.lc-btn {
  background: #d8a85e;
  color: #fff;
  padding: 10px 25px;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 1.5px;
  border-radius: 4px;
  text-transform: uppercase;
  transition: background 0.3s ease;
  opacity: 0.9;
}
.lc-btn:hover {
  background: #c2934b;
  opacity: 1;
}

/* Responsive */
@media(max-width: 992px) {
  .lc-grid {
    grid-template-columns: repeat(2, 1fr) !important;
  }
}
@media(max-width: 768px) {
  .lc-grid {
    grid-template-columns: 1fr !important;
  }
  .lc-page-title {
    font-size: 32px;
  }
}
</style>