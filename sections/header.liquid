{%- assign menu_handle = section.settings.menu | default: 'main-menu' -%}
{%- assign menu_links = linklists[menu_handle].links -%}

<header
  class="dk-header {% if section.settings.enable_sticky %}dk-header--sticky{% endif %}"
  id="dkHeader"
  data-section-id="{{ section.id }}"
  role="banner"
>
  {%- comment -%} =====================================================
    TOP HEADER ROW: MENU TOGGLE (MOBILE) | LOGO (CENTER) | ACTIONS (RIGHT)
  ==================================================== {%- endcomment -%}
  <div class="dk-header__top">
    <div class="container dk-header__top-container">
      
      <!-- LEFT AREA (MOBILE MENU TOGGLE / DESKTOP SPACER) -->
      <div class="dk-header__left">
        <button
          type="button"
          class="dk-header__toggle"
          id="dkMobileToggle"
          onclick="toggleDkMobileMenu()"
          aria-label="Open Navigation Menu"
          aria-expanded="false"
          aria-controls="dkMobileDrawer"
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- BRAND LOGO / WORDMARK -->
      <div class="dk-header__logo">
        <a href="{{ routes.root_url }}" class="dk-header__logo-link">
          {%- if section.settings.logo_image != blank -%}
            {%- assign logo_alt = section.settings.logo_image.alt | default: shop.name | escape -%}
            <img
              src="{{ section.settings.logo_image | image_url: width: 500 }}"
              alt="{{ logo_alt }}"
              class="dk-header__logo-img"
              width="{{ section.settings.logo_width | default: 160 }}"
              height="60"
              style="max-width: {{ section.settings.logo_width | default: 160 }}px; height: auto;"
              loading="eager"
            >
          {%- else -%}
            <img
              src="{{ 'dk-logo.png' | asset_url }}"
              alt="{{ shop.name | default: 'DELISHA KARIGARI' | escape }}"
              class="dk-header__logo-img"
              width="{{ section.settings.logo_width | default: 160 }}"
              height="60"
              style="max-width: {{ section.settings.logo_width | default: 160 }}px; height: auto;"
              loading="eager"
            >
          {%- endif -%}
        </a>
      </div>

      <!-- HEADER ACTION ICONS (SEARCH / ACCOUNT / WISHLIST / CART) -->
      <div class="dk-header__actions">
        {%- if section.settings.show_search -%}
          <button
            type="button"
            class="dk-header__icon-btn dk-header__icon-search"
            aria-label="Search"
            onclick="if(typeof openSearchModal === 'function') { openSearchModal(); } else { window.location.href='{{ routes.search_url }}'; }"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="7"></circle>
              <line x1="20" y1="20" x2="16" y2="16"></line>
            </svg>
          </button>
        {%- endif -%}

        {%- if section.settings.show_account -%}
          {%- assign account_url = routes.account_url -%}
          {%- assign login_url = routes.account_login_url -%}
          <a
            href="{% if customer != blank %}{{ account_url }}{% else %}{{ login_url }}{% endif %}"
            class="dk-header__icon-btn dk-header__icon-account"
            aria-label="Account"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="8" r="4"></circle>
              <path d="M4 20c0-4 4-6 8-6s8 2 8 6"></path>
            </svg>
          </a>
        {%- endif -%}

        {%- if section.settings.show_wishlist -%}
          <a
            href="#"
            class="dk-header__icon-btn dk-header__icon-wishlist"
            id="HeaderWishlistIcon"
            aria-label="Wishlist"
            onclick="if(typeof window.openWishlist === 'function') { window.openWishlist(); return false; }"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
            </svg>
            <span class="wishlist-count" id="WishlistCount">0</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          <a
            href="{{ routes.cart_url }}"
            class="dk-header__icon-btn dk-header__icon-cart"
            id="HeaderCartIcon"
            aria-label="Cart"
            onclick="if(typeof ShopifyCart !== 'undefined' && typeof ShopifyCart.openDrawer === 'function') { ShopifyCart.openDrawer(); return false; }"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path>
              <line x1="3" y1="6" x2="21" y2="6"></line>
              <path d="M16 10a4 4 0 0 1-8 0"></path>
            </svg>
            <span class="cart-count" id="HeaderCartCount">{{ cart.item_count | default: 0 }}</span>
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>

  {%- comment -%} =====================================================
    DESKTOP CATEGORY NAVIGATION ROW
  ==================================================== {%- endcomment -%}
  <nav class="dk-header__nav" aria-label="Main Navigation">
    <div class="container dk-header__nav-container">
      <ul class="dk-header__menu" role="list">
        {%- if menu_links != blank -%}
          {%- for link in menu_links -%}
            {%- assign has_dropdown = false -%}
            {%- if link.links != blank -%}
              {%- assign has_dropdown = true -%}
            {%- endif -%}

            {%- assign mega_block = blank -%}
            {%- for block in section.blocks -%}
              {%- if block.type == 'mega_menu' and block.settings.menu_item == link.title -%}
                {%- assign mega_block = block -%}
                {%- assign has_dropdown = true -%}
              {%- endif -%}
            {%- endfor -%}

            <li class="dk-header__menu-item {% if has_dropdown %}has-dropdown{% endif %}">
              <a
                href="{{ link.url }}"
                class="dk-header__menu-link {% if link.active %}is-active{% endif %}"
                {% if has_dropdown %}aria-expanded="false" aria-haspopup="true"{% endif %}
              >
                {{ link.title | escape }}
                {%- if has_dropdown -%}
                  <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5" class="dk-header__menu-arrow">
                    <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {%- endif -%}
              </a>

              {%- if has_dropdown -%}
                <div class="dk-header__dropdown">
                  {%- if link.links != blank or mega_block != blank -%}
                    {%- render 'mega-menu', link: link, mega_menu_block: mega_block -%}
                  {%- endif -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <!-- FALLBACK MENU ITEMS -->
          <li class="dk-header__menu-item"><a href="{{ routes.all_products_collection_url }}" class="dk-header__menu-link">SHOP ALL</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/royal-pearl-rakhi-collection" class="dk-header__menu-link">ROYAL PEARL</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/nazariya-collection" class="dk-header__menu-link">NAZARIYA</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/blessed-collection" class="dk-header__menu-link">BLESSED</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/festive-rakhi-collection" class="dk-header__menu-link">FESTIVE RAKHIS</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.collections_url }}/bhaiya-bhabhi" class="dk-header__menu-link">BHAIYA BHABHI</a></li>
          <li class="dk-header__menu-item"><a href="{{ routes.root_url }}pages/about" class="dk-header__menu-link">ABOUT</a></li>
        {%- endif -%}
      </ul>
    </div>
  </nav>

  {%- comment -%} =====================================================
    MOBILE SLIDE-OUT DRAWER NAVIGATION
  ==================================================== {%- endcomment -%}
  <div class="dk-mobile-drawer" id="dkMobileDrawer" aria-hidden="true" role="dialog" aria-label="Mobile Navigation">
    <div class="dk-mobile-drawer__header">
      <img
        src="{{ 'dk-logo.png' | asset_url }}"
        alt="{{ shop.name | default: 'DELISHA KARIGARI' | escape }}"
        class="dk-header__logo-img"
        width="{{ section.settings.mobile_logo_width | default: 130 }}"
        height="50"
        style="max-width: {{ section.settings.mobile_logo_width | default: 130 }}px; height: auto;"
        loading="eager"
      >
      <button
        type="button"
        class="dk-mobile-drawer__close"
        onclick="toggleDkMobileMenu()"
        aria-label="Close Navigation Menu"
      >
        &times;
      </button>
    </div>

    <!-- MOBILE SEARCH BAR INTEGRATION -->
    <div class="dk-mobile-drawer__search">
      <form action="{{ routes.search_url }}" method="get" role="search" class="dk-mobile-search-form">
        <input type="hidden" name="type" value="product">
        <input
          type="search"
          name="q"
          placeholder="Search Rakhi, Jewellery, Gifts..."
          class="dk-mobile-search-input"
          aria-label="Search Store"
        >
        <button type="submit" class="dk-mobile-search-btn" aria-label="Submit Search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="20" y1="20" x2="16" y2="16"></line>
          </svg>
        </button>
      </form>
    </div>

    <div class="dk-mobile-drawer__body">
      <ul class="dk-mobile-menu" role="list">
        {%- if menu_links != blank -%}
          {%- for link in menu_links -%}
            <li class="dk-mobile-menu__item {% if link.links != blank %}has-accordion{% endif %}">
              <div class="dk-mobile-menu__row">
                <a href="{{ link.url }}" class="dk-mobile-menu__link">
                  {{ link.title | escape }}
                </a>
                {%- if link.links != blank -%}
                  <button
                    type="button"
                    class="dk-mobile-menu__accordion-toggle"
                    aria-label="Toggle {{ link.title }} Submenu"
                    onclick="toggleDkAccordion(this)"
                  >
                    <svg width="12" height="8" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8">
                      <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </button>
                {%- endif -%}
              </div>

              {%- if link.links != blank -%}
                <ul class="dk-mobile-submenu" role="list" style="display: none;">
                  {%- for childlink in link.links -%}
                    <li class="dk-mobile-submenu__item {% if childlink.links != blank %}has-nested{% endif %}">
                      <div class="dk-mobile-submenu__row">
                        <a href="{{ childlink.url }}" class="dk-mobile-submenu__link">
                          {{ childlink.title | escape }}
                        </a>
                        {%- if childlink.links != blank -%}
                          <button
                            type="button"
                            class="dk-mobile-menu__accordion-toggle"
                            aria-label="Toggle {{ childlink.title }} Submenu"
                            onclick="toggleDkAccordion(this)"
                          >
                            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.8">
                              <path d="M1 1L5 5L9 1" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                          </button>
                        {%- endif -%}
                      </div>

                      {%- if childlink.links != blank -%}
                        <ul class="dk-mobile-grandchild-menu" role="list" style="display: none;">
                          {%- for grandchild in childlink.links -%}
                            <li>
                              <a href="{{ grandchild.url }}" class="dk-mobile-grandchild-link">
                                {{ grandchild.title | escape }}
                              </a>
                            </li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li><a href="{{ routes.all_products_collection_url }}" class="dk-mobile-menu__link">SHOP ALL</a></li>
          <li><a href="{{ routes.collections_url }}/royal-pearl-rakhi-collection" class="dk-mobile-menu__link">ROYAL PEARL</a></li>
          <li><a href="{{ routes.collections_url }}/nazariya-collection" class="dk-mobile-menu__link">NAZARIYA</a></li>
          <li><a href="{{ routes.collections_url }}/blessed-collection" class="dk-mobile-menu__link">BLESSED</a></li>
          <li><a href="{{ routes.collections_url }}/festive-rakhi-collection" class="dk-mobile-menu__link">FESTIVE RAKHIS</a></li>
          <li><a href="{{ routes.collections_url }}/bhaiya-bhabhi" class="dk-mobile-menu__link">BHAIYA BHABHI</a></li>
          <li><a href="{{ routes.root_url }}pages/about" class="dk-mobile-menu__link">ABOUT</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>

  <div class="dk-mobile-overlay" id="dkMobileOverlay" onclick="toggleDkMobileMenu()"></div>
</header>

<script>
  function toggleDkMobileMenu() {
    const drawer = document.getElementById('dkMobileDrawer');
    const overlay = document.getElementById('dkMobileOverlay');
    const toggleBtn = document.getElementById('dkMobileToggle');
    if (!drawer || !overlay) return;

    const isActive = drawer.classList.contains('is-open');
    if (isActive) {
      drawer.classList.remove('is-open');
      overlay.classList.remove('is-open');
      document.body.classList.remove('overflow-hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'false');
    } else {
      drawer.classList.add('is-open');
      overlay.classList.add('is-open');
      document.body.classList.add('overflow-hidden');
      if (toggleBtn) toggleBtn.setAttribute('aria-expanded', 'true');
    }
  }

  function toggleDkAccordion(btn) {
    const row = btn.closest('.dk-mobile-menu__row') || btn.closest('.dk-mobile-submenu__row');
    if (!row) return;
    const parentLi = row.parentElement;
    const subMenu = parentLi.querySelector('.dk-mobile-submenu, .dk-mobile-grandchild-menu');
    if (!subMenu) return;

    const isOpen = subMenu.style.display === 'block';
    if (isOpen) {
      subMenu.style.display = 'none';
      btn.classList.remove('is-open');
    } else {
      subMenu.style.display = 'block';
      btn.classList.add('is-open');
    }
  }
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo_image",
      "label": "Logo Image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 100,
      "max": 300,
      "step": 10,
      "unit": "px",
      "label": "Desktop Logo Width",
      "default": 160
    },
    {
      "type": "range",
      "id": "mobile_logo_width",
      "min": 80,
      "max": 200,
      "step": 5,
      "unit": "px",
      "label": "Mobile Logo Width",
      "default": 130
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main Navigation Menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable Sticky Header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show Search Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show Account Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show Wishlist Icon",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show Cart Icon",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "mega_menu",
      "name": "Mega Menu Item",
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Matching Menu Item Title",
          "info": "Enter exact menu title e.g. 'SHOP' or 'RAKHI'"
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "Featured Promo Image"
        },
        {
          "type": "text",
          "id": "featured_tag",
          "label": "Featured Subtitle Tag",
          "default": "CURATED GIFTING"
        },
        {
          "type": "text",
          "id": "featured_heading",
          "label": "Featured Heading",
          "default": "Raksha Bandhan Special Sets"
        },
        {
          "type": "url",
          "id": "featured_link",
          "label": "Featured Card Link"
        },
        {
          "type": "text",
          "id": "featured_button_text",
          "label": "Featured CTA Text",
          "default": "Explore Collection"
        }
      ]
    }
  ]
}
{% endschema %}