<section
  id="dk-featured-products-{{ section.id }}"
  class="dk-featured-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding: {{ section.settings.padding_top | default: 70 }}px 0 {{ section.settings.padding_bottom | default: 70 }}px 0;"
>
  <div class="container">
    <div class="dk-section-header text-center">
      {%- if section.settings.subheading != blank -%}
        <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="dk-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    {%- assign collection = collections[section.settings.collection] -%}
    {%- assign limit = section.settings.products_to_show | default: 6 -%}

    <div class="dk-product-grid">
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} REAL CATALOG SHOWCASE FALLBACK {%- endcomment -%}
        {%- assign fallback_titles = "Mayur Nazar Trio|Shree Ganesh Rakhi Trio|Emerald Noor Pearl Set|Rangrez Designer Duo|Nazar Noor Bhaiya Bhabhi Set|Shri Radha Krishna Trio|Krishna Bansuri Lumba Set|Shubh Kundan Rakhi Duo" | split: "|" -%}
        {%- assign fallback_prices = "₹599.00|₹899.00|₹899.00|₹599.00|₹999.00|₹699.00|₹999.00|₹599.00" | split: "|" -%}
        {%- assign fallback_compares = "₹899.00|₹1,299.00|₹1,299.00|₹899.00|₹1,499.00|₹999.00|₹1,499.00|₹899.00" | split: "|" -%}
        {%- assign fallback_imgs = "dk-cat-nazariya.jpg|dk-cat-blessed.jpg|dk-cat-royal-pearl.jpg|dk-cat-festive.jpg|dk-cat-bhaiya-bhabhi.jpg|dk-cat-sets.jpg|dk-rec-couples.jpg|dk-rec-brother.jpg" | split: "|" -%}
        
        {%- for i in (0..7) -%}
          {%- if forloop.index > limit -%}{%- break -%}{%- endif -%}
          {%- assign p_title = fallback_titles[i] -%}
          {%- assign p_price = fallback_prices[i] -%}
          {%- assign p_compare = fallback_compares[i] -%}
          {%- assign p_img = fallback_imgs[i] -%}

          <div class="dk-product-card">
            <div class="dk-product-card__media">
              <a href="{{ routes.all_products_collection_url }}" class="dk-product-card__image-link" aria-label="{{ p_title | escape }}">
                <img
                  src="{{ p_img | asset_url }}"
                  alt="{{ p_title | escape }}"
                  class="dk-product-card__img dk-product-card__img--primary"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              </a>
              <div class="dk-product-card__badges">
                <span class="dk-badge dk-badge--sale">FESTIVE EDIT</span>
              </div>
              <button
                type="button"
                class="dk-product-card__wishlist-btn"
                aria-label="Add {{ p_title | escape }} to wishlist"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                </svg>
              </button>
            </div>
            <div class="dk-product-card__info">
              <h3 class="dk-product-card__title">
                <a href="{{ routes.all_products_collection_url }}">{{ p_title }}</a>
              </h3>
              <div class="dk-product-card__price">
                <span class="dk-product-card__price-current dk-product-card__price--sale">{{ p_price }}</span>
                <s class="dk-product-card__price-compare">{{ p_compare }}</s>
              </div>
              <a href="{{ routes.all_products_collection_url }}" class="dk-product-card__add-btn" style="display: block; text-decoration: none; text-align: center;">
                View Product
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and collection != blank -%}
      <div class="text-center" style="margin-top: var(--dk-space-xl, 2.5rem);">
        <a href="{{ collection.url }}" class="dk-btn dk-btn-secondary">
          {{ section.settings.view_all_label | default: 'VIEW ALL PRODUCTS' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .dk-product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--dk-space-lg, 1.5rem);
  }

  @media (max-width: 1024px) {
    .dk-product-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--dk-space-md, 1rem);
    }
  }

  @media (max-width: 600px) {
    .dk-product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--dk-space-sm, 0.5rem);
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Bestsellers Grid",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "HANDCRAFTED TREASURES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Favourites"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Most cherished pieces handcrafted for your celebrations."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 2,
      "label": "Products to Show",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show View All Button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View All Label",
      "default": "VIEW ALL FAVOURITES"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "presets": [
    {
      "name": "DELISHA Bestsellers Grid"
    }
  ]
}
{% endschema %}
