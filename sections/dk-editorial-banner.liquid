<section
  id="dk-editorial-banner-{{ section.id }}"
  class="dk-editorial-sec"
  style="background-color: {{ section.settings.bg_color | default: '#6E1F2A' }};"
>
  <div class="dk-editorial__wrapper">
    <div class="dk-editorial__media">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 2400 }}"
          alt="{{ section.settings.heading | escape }}"
          class="dk-editorial__img"
          loading="lazy"
          width="2400"
          height="1000"
        >
      {%- else -%}
        <img
          src="{{ 'dk-hero-banner-2.jpg' | asset_url }}"
          alt="{{ section.settings.heading | default: 'Crafted For Unforgettable Celebrations' | escape }}"
          class="dk-editorial__img"
          loading="lazy"
          width="2400"
          height="1000"
        >
      {%- endif -%}
      <div
        class="dk-editorial__overlay"
        style="background: linear-gradient(90deg, rgba(37,37,37, {{ section.settings.overlay_opacity | divided_by: 100.0 | default: 0.55 }}) 0%, rgba(37,37,37, {{ section.settings.overlay_opacity | divided_by: 100.0 | default: 0.25 }}) 100%);"
      ></div>
    </div>

    <div class="dk-editorial__container container">
      <div class="dk-editorial__content text-{{ section.settings.content_alignment | default: 'left' }}">
        {%- if section.settings.subheading != blank -%}
          <span class="dk-editorial__subtitle">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="dk-editorial__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <p class="dk-editorial__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="dk-btn dk-btn-gold"
          >
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .dk-editorial-sec {
    position: relative;
    width: 100%;
    overflow: hidden;
  }
  .dk-editorial__wrapper {
    position: relative;
    width: 100%;
    min-height: 480px;
    display: flex;
    align-items: center;
  }
  .dk-editorial__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .dk-editorial__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .dk-editorial__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--dk-color-primary, #6E1F2A);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dk-editorial__placeholder-svg {
    width: 100%;
    height: 100%;
    opacity: 0.25;
  }
  .dk-editorial__overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }
  .dk-editorial__container {
    position: relative;
    z-index: 3;
    width: 100%;
    padding-top: var(--dk-space-2xl, 4rem);
    padding-bottom: var(--dk-space-2xl, 4rem);
  }
  .dk-editorial__content {
    max-width: 580px;
    color: #FFFFFF;
  }
  .dk-editorial__content.text-left { margin-left: 0; text-align: left; }
  .dk-editorial__content.text-center { margin: 0 auto; text-align: center; }
  .dk-editorial__content.text-right { margin-left: auto; text-align: right; }

  .dk-editorial__subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 3px;
    color: var(--dk-color-gold, #B89552);
    font-weight: 600;
    display: block;
    margin-bottom: 8px;
  }
  .dk-editorial__heading {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 600;
    line-height: 1.2;
    color: #FFFFFF;
    margin-bottom: var(--dk-space-md, 1rem);
  }
  .dk-editorial__text {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    line-height: 1.6;
    color: rgba(255,255,255,0.9);
    margin-bottom: var(--dk-space-xl, 2rem);
    font-weight: 300;
  }

  @media (max-width: 768px) {
    .dk-editorial__wrapper {
      min-height: 380px;
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Editorial Banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Lifestyle Banner Image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 45
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "THE FESTIVE EDIT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted For Unforgettable Celebrations"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description Text",
      "default": "Thoughtfully crafted pieces for celebrations that deserve to be remembered."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#6E1F2A"
    }
  ],
  "presets": [
    {
      "name": "DELISHA Editorial Banner"
    }
  ]
}
{% endschema %}
