<div class="product-main-wrapper" style="background-color: {{ section.settings.bg_color }};">
  <div class="prod-container">
    <div class="prod-layout">
      
      <!-- Left: Gallery -->
      <div class="prod-gallery">
        <div class="prod-main-image-wrap">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}" class="prod-main-image" id="MainProductImage" width="1200" height="1200">
          {% else %}
            {{ 'product-1' | placeholder_svg_tag: 'prod-placeholder' }}
          {% endif %}
        </div>
        
        <div class="prod-thumbnails">
          {% for image in product.images %}
            <div class="prod-thumb-item {% if forloop.first %}active{% endif %}" onclick="updateProductImage(this, '{{ image | image_url: width: 1200 }}')">
              <img src="{{ image | image_url: width: 300 }}" alt="{{ image.alt | default: product.title | escape }}" width="300" height="300">
            </div>
          {% endfor %}
        </div>
      </div>
      
      <!-- Right: Info -->
      <div class="prod-info">
        <form method="post" action="{{ routes.cart_add_url }}" id="AddToCartForm" class="prod-form">
          <input type="hidden" name="id" value="{{ product.selected_or_firstAvailable_variant.id | default: product.variants.first.id }}">
          
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              
              {%- when '@app' -%}
                {% render block %}

              {%- when 'title' -%}
                <h1 class="prod-title-small" {{ block.shopify_attributes }}>{{ product.title }}</h1>

              {%- when 'rating' -%}
                <div class="prod-rating" {{ block.shopify_attributes }}>
                  <span class="stars">★★★★★</span>
                  <span class="rating-count">1 Review</span>
                </div>

              {%- when 'price' -%}
                <div class="prod-price-box" {{ block.shopify_attributes }}>
                  <span class="prod-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price > product.price %}
                    <s class="prod-compare-price">{{ product.compare_at_price | money }}</s>
                  {% endif %}
                </div>

              {%- when 'description' -%}
                <div class="prod-short-desc" {{ block.shopify_attributes }}>
                  {{ product.description | strip_html | truncatewords: 30 }}
                </div>

              {%- when 'variant_picker' -%}
                {% unless product.has_only_default_variant %}
                  <div class="prod-variants" {{ block.shopify_attributes }}>
                    {% for option in product.options_with_values %}
                      <div class="variant-group">
                        <label class="variant-label">{{ option.name }}: <span class="selected-val">{{ option.selected_value }}</span></label>
                        <div class="variant-swatches">
                          {% for value in option.values %}
                            <div class="swatch-item">
                              <input type="radio" id="{{ option.name }}-{{ value }}" name="options[{{ option.name }}]" value="{{ value }}" {% if option.selected_value == value %}checked{% endif %} onchange="updateVariantLabel(this)">
                              <label for="{{ option.name }}-{{ value }}" class="swatch-label {% if option.name == 'Color' or option.name == 'color' %}color-swatch{% endif %}" style="{% if option.name == 'Color' or option.name == 'color' %}background-color: {{ value | downcase }};{% endif %}">
                                {% unless option.name == 'Color' or option.name == 'color' %}{{ value }}{% endunless %}
                              </label>
                            </div>
                          {% endfor %}
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% endunless %}

              {%- when 'buy_buttons' -%}
                <div {{ block.shopify_attributes }}>
                  <div class="prod-actions-row">
                    <div class="qty-selector">
                      <button type="button" onclick="changeQty(-1)">-</button>
                      <input type="number" name="quantity" value="1" min="1" id="Quantity">
                      <button type="button" onclick="changeQty(1)">+</button>
                    </div>
                    <button type="button" class="add-to-cart-btn" onclick="ShopifyCart.addItem(this.closest('form'))">
                      ADD TO CART
                    </button>
                    <div class="action-icons">
                      <button type="button" class="icon-btn wishlist-btn" data-product-handle="{{ product.handle }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg></button>
                      <button type="button" class="icon-btn"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 3 21 3 21 8"></polyline><line x1="4" y1="20" x2="21" y2="3"></line><polyline points="21 16 21 21 16 21"></polyline><line x1="15" y1="15" x2="21" y2="21"></line><line x1="4" y1="4" x2="9" y2="9"></line></svg></button>
                    </div>
                  </div>
                  
                  <button type="button" class="buy-now-btn" onclick="window.location.href='/checkout'">
                    BUY IT NOW
                  </button>
                </div>

              {%- when 'trust_points' -%}
                <div class="prod-trust-points" {{ block.shopify_attributes }}>
                  {%- assign text1 = block.settings.text_1 | default: 'Estimate delivery between 12-20 days [Free for all order]' -%}
                  {%- assign text2 = block.settings.text_2 | default: 'Free return within 30 days of purchase' -%}
                  
                  {%- if text1 != blank -%}
                    <div class="trust-item">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"></polygon><circle cx="5.5" cy="18.5" r="2.5"></circle><circle cx="18.5" cy="18.5" r="2.5"></circle></svg>
                      {{ text1 }}
                    </div>
                  {%- endif -%}

                  {%- if text2 != blank -%}
                    <div class="trust-item">
                      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 4 23 10 17 10"></polyline><path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path></svg>
                      {{ text2 }}
                    </div>
                  {%- endif -%}
                </div>

              {%- when 'payment_methods' -%}
                <div class="payment-methods" {{ block.shopify_attributes }}>
                  <img src="https://cdn.shopify.com/s/files/1/0661/7553/3285/files/payment-icons.png?v=1715600000" alt="Payments" style="max-width: 250px;" width="250" height="40">
                  <p>Guarantee safe & secure checkout</p>
                </div>

              {%- when 'return_policy' -%}
                <div class="prod-return-policy" {{ block.shopify_attributes }}>
                  <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="#64142D" stroke-width="1.5">
                    <path d="M21.5 12a9.5 9.5 0 0 1-19 0 9.5 9.5 0 0 1 15-7.5L21 7"></path>
                    <path d="M21 2v5h-5"></path>
                    <polygon points="12 8 8 10 12 12 16 10 12 8"></polygon>
                    <polygon points="8 10 8 14 12 16 12 12 8 10"></polygon>
                    <polygon points="16 10 16 14 12 16 12 12 16 10"></polygon>
                  </svg>
                  <div class="return-text">
                    <strong>{{ block.settings.heading | default: 'Easy 7 Days' }}</strong>
                    <span>Return</span>
                  </div>
                </div>

              {%- when 'accordion' -%}
                <div class="info-box-wrapper" {{ block.shopify_attributes }} style="margin-bottom: 10px;">
                  <div class="info-box" onclick="toggleAccordion(this)">
                    <span>{{ block.settings.heading | escape }}</span>
                    <span>+</span>
                  </div>
                  <div class="info-box-content" style="display: none; padding: 15px 20px; border: 1px solid #eee; border-top: none; border-radius: 0 0 30px 30px; margin-top: -10px; font-size: 14px; color: #666; background: #fff;">
                    {{ block.settings.content }}
                  </div>
                </div>

            {%- endcase -%}
          {%- endfor -%}
        </form>
      </div>
    </div>
  </div>
</div>

    
      



<style>
/* Global */
.prod-container { width: 90%; max-width: 1300px; margin: 0 auto; padding: 0 20px; }

/* Main Section */
.product-main-wrapper { padding: 80px 0; }
.prod-layout { display: flex; gap: 60px; }
.prod-gallery { flex: 0 0 50%; }
.prod-info { flex: 1; }

/* Gallery */
.prod-main-image-wrap { border-radius: 20px; overflow: hidden; margin-bottom: 20px; box-shadow: 0 10px 40px rgba(0,0,0,0.05); }
.prod-main-image { width: 100%; height: auto; display: block; }
.prod-thumbnails { display: flex; gap: 15px; }
.prod-thumb-item { width: 100px; height: 100px; border-radius: 12px; overflow: hidden; cursor: pointer; border: 2px solid transparent; }
.prod-thumb-item.active { border-color: #d8a85e; }
.prod-thumb-item img { width: 100%; height: 100%; object-fit: cover; }

/* Product Info */
.prod-title-small { font-family: var(--font-heading, serif); font-size: 32px; margin: 0 0 10px 0; }
.prod-rating { margin-bottom: 20px; color: #f2b600; font-size: 14px; }
.rating-count { color: #888; margin-left: 10px; }
.prod-price-box { margin-bottom: 20px; display: flex; align-items: center; gap: 15px; }
.prod-price { font-size: 28px; font-weight: 600; color: #caa25d; }
.prod-compare-price { color: #999; font-size: 20px; }
.prod-short-desc { font-size: 15px; line-height: 1.6; color: #666; margin-bottom: 30px; }

/* Variants */
.variant-group { margin-bottom: 25px; }
.variant-label { display: block; font-size: 14px; font-weight: 600; margin-bottom: 12px; }
.variant-swatches { display: flex; gap: 12px; flex-wrap: wrap; }
.swatch-item input { display: none; }
.swatch-label {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 45px;
  height: 45px;
  padding: 0 15px;
  border-radius: 8px;
  border: 1px solid #ddd;
  cursor: pointer;
  font-size: 13px;
  font-weight: 500;
  transition: all 0.2s;
}
.swatch-label.color-swatch { border-radius: 50%; min-width: 30px; height: 30px; padding: 0; }
.swatch-item input:checked + .swatch-label { border-color: #caa25d; background: #fffaf0; }
.swatch-item input:checked + .swatch-label.color-swatch { border-color: #000; box-shadow: 0 0 0 2px #fff, 0 0 0 4px #caa25d; }

/* Actions */
.prod-actions-row { display: flex; gap: 15px; align-items: center; margin-bottom: 15px; }
.qty-selector {
  display: flex;
  align-items: center;
  border: 1px solid #ddd;
  border-radius: 30px;
  overflow: hidden;
  height: 50px;
}
.qty-selector button { width: 40px; border: none; background: transparent; cursor: pointer; font-size: 18px; }
.qty-selector input { width: 40px; border: none; text-align: center; font-size: 16px; outline: none; }
.add-to-cart-btn {
  flex: 1;
  height: 50px;
  background: #f8d4b4;
  color: #333;
  border: none;
  border-radius: 30px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.3s;
}
.add-to-cart-btn:hover { background: #caa25d; color: #fff; }
.action-icons { display: flex; gap: 10px; }
.icon-btn { width: 50px; height: 50px; border-radius: 50%; border: 1px solid #ddd; background: transparent; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #666; }
.buy-now-btn { width: 100%; height: 50px; background: #f8d4b4; color: #333; border: none; border-radius: 30px; font-weight: 600; cursor: pointer; margin-bottom: 30px; }

/* Trust */
.prod-trust-points { margin-bottom: 30px; }
.trust-item { display: flex; align-items: center; gap: 10px; font-size: 13px; color: #555; margin-bottom: 12px; }
.payment-methods { text-align: center; padding: 20px; border: 1px solid #eee; border-radius: 15px; margin-bottom: 30px; }
.payment-methods p { font-size: 12px; color: #888; margin-top: 10px; }
.extra-info-boxes { display: flex; flex-direction: column; gap: 10px; }
.info-box { padding: 15px 20px; border: 1px solid #eee; border-radius: 30px; display: flex; justify-content: space-between; font-size: 14px; font-weight: 500; cursor: pointer; }

/* Return Policy */
.prod-return-policy {
  display: flex;
  align-items: center;
  gap: 15px;
  background: #FDF9F4;
  border: 1px solid #f2e9de;
  border-radius: 12px;
  padding: 12px 18px;
  margin-bottom: 25px;
  width: fit-content;
  box-shadow: 0 4px 8px rgba(0,0,0,0.02);
}
.prod-return-policy svg {
  flex-shrink: 0;
}
.return-text {
  display: flex;
  flex-direction: column;
  line-height: 1.3;
}
.return-text strong {
  font-size: 16px;
  color: #111;
  font-family: var(--font-body, sans-serif);
}
.return-text span {
  font-size: 15px;
  color: #333;
}

/* Tabs */
.product-tabs-section { margin-top: 80px; border-top: 1px solid #eee; padding-top: 60px; }
.tabs-header { display: flex; gap: 40px; border-bottom: 1px solid #eee; margin-bottom: 40px; }
.tab-btn { background: transparent; border: none; padding: 15px 0; font-size: 18px; font-weight: 600; cursor: pointer; color: #999; display: flex; align-items: center; gap: 10px; position: relative; }
.tab-btn.active { color: #000; }
.tab-btn.active::after { content: ''; position: absolute; bottom: -1px; left: 0; width: 100%; height: 2px; background: #caa25d; }
.tab-content { display: none; line-height: 1.8; color: #555; }
.tab-content.active { display: block; }



@media(max-width: 992px) {
  .prod-layout { flex-direction: column; gap: 30px; }
  .prod-gallery { max-width: 100%; width: 100%; }
  .prod-thumbnails {
    display: flex;
    gap: 10px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    padding-bottom: 8px;
  }
  .prod-thumb-item {
    flex: 0 0 80px;
    width: 80px;
    height: 80px;
    scroll-snap-align: start;
  }
  .tabs-header { gap: 20px; overflow-x: auto; white-space: nowrap; }
  .tab-btn { font-size: 14px; }
}

@media(max-width: 768px) {
  .product-main-wrapper { padding: 40px 0; }
}

@media(max-width: 480px) {
  .prod-actions-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 10px;
  }
  .action-icons {
    grid-column: span 2;
    justify-content: center;
  }
}
</style>

<script>
function updateProductImage(el, url) {
  document.getElementById('MainProductImage').src = url;
  document.querySelectorAll('.prod-thumb-item').forEach(item => item.classList.remove('active'));
  el.classList.add('active');
}

function updateVariantLabel(input) {
  const val = input.value;
  input.closest('.variant-group').querySelector('.selected-val').innerText = val;
}

function changeQty(amt) {
  const input = document.getElementById('Quantity');
  let val = parseInt(input.value) + amt;
  if (val < 1) val = 1;
  input.value = val;
}

function openTab(evt, tabName) {
  var i, tabcontent, tablinks;
  tabcontent = document.getElementsByClassName("tab-content");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].classList.remove("active");
  }
  tablinks = document.getElementsByClassName("tab-btn");
  for (i = 0; i < tablinks.length; i++) {
    tablinks[i].classList.remove("active");
  }
  document.getElementById(tabName).classList.add("active");
  evt.currentTarget.classList.add("active");
}

function toggleAccordion(el) {
  const content = el.nextElementSibling;
  const symbol = el.querySelector('span:last-child');
  if (content.style.display === 'none' || !content.style.display) {
    content.style.display = 'block';
    if (symbol) symbol.textContent = '−';
    el.style.borderRadius = '30px 30px 0 0';
    el.style.borderBottom = 'none';
  } else {
    content.style.display = 'none';
    if (symbol) symbol.textContent = '+';
    el.style.borderRadius = '30px';
    el.style.borderBottom = '1px solid #eee';
  }
}


</script>

