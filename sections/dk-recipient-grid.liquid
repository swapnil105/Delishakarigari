<section
  id="dk-recipient-grid-{{ section.id }}"
  class="dk-recipient-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding: {{ section.settings.padding_top | default: 70 }}px 0 {{ section.settings.padding_bottom | default: 70 }}px 0;"
>
  <div class="container">
    <div class="dk-section-header text-center">
      {%- if section.settings.subheading != blank -%}
        <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="dk-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="dk-recipient-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign card_title = block.settings.title | default: 'For Someone Special' -%}
          {%- assign card_url = block.settings.link | default: routes.all_products_collection_url -%}

          <a href="{{ card_url }}" class="dk-recipient-card" {{ block.shopify_attributes }}>
            <div class="dk-recipient-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ card_title | escape }}"
                  class="dk-recipient-card__img"
                  loading="lazy"
                  width="600"
                  height="750"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}{%- assign fallback_img = 'dk-rec-sister.jpg' -%}
                  {%- when 2 -%}{%- assign fallback_img = 'dk-rec-mother.jpg' -%}
                  {%- when 3 -%}{%- assign fallback_img = 'dk-rec-brother.jpg' -%}
                  {%- when 4 -%}{%- assign fallback_img = 'dk-rec-bhabhi.jpg' -%}
                  {%- when 5 -%}{%- assign fallback_img = 'dk-rec-family.jpg' -%}
                  {%- else -%}{%- assign fallback_img = 'dk-rec-couples.jpg' -%}
                {%- endcase -%}
                <img
                  src="{{ fallback_img | asset_url }}"
                  alt="{{ card_title | escape }}"
                  class="dk-recipient-card__img"
                  loading="lazy"
                  width="600"
                  height="750"
                >
              {%- endif -%}
              <div class="dk-recipient-card__overlay"></div>
            </div>

            <div class="dk-recipient-card__content text-center">
              <h3 class="dk-recipient-card__title">{{ card_title | escape }}</h3>
              {%- if block.settings.tagline != blank -%}
                <span class="dk-recipient-card__tag">{{ block.settings.tagline | escape }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_recipients = "Sister,Mother,Husband,Wife,Friend,Kids,Couples" | split: "," -%}
        {%- for rec in fallback_recipients -%}
          <div class="dk-recipient-card">
            <div class="dk-recipient-card__media">
              {{ 'collection-1' | placeholder_svg_tag: 'dk-recipient-card__placeholder' }}
              <div class="dk-recipient-card__overlay"></div>
            </div>
            <div class="dk-recipient-card__content text-center">
              <h3 class="dk-recipient-card__title">For {{ rec }}</h3>
              <span class="dk-recipient-card__tag">Handcrafted & Personal</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .dk-recipient-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--dk-space-lg, 1.5rem);
  }
  .dk-recipient-card {
    display: block;
    position: relative;
    border-radius: var(--dk-radius-md, 8px);
    overflow: hidden;
    text-decoration: none;
    background-color: var(--dk-color-white, #FFFFFF);
    border: 1px solid var(--dk-color-border, rgba(110,31,42,0.12));
    transition: var(--dk-transition, all 0.3s ease);
  }
  .dk-recipient-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(110,31,42,0.1);
    border-color: rgba(110,31,42,0.25);
  }
  .dk-recipient-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    background-color: var(--dk-color-background-secondary, #F2E5DD);
  }
  .dk-recipient-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .dk-recipient-card:hover .dk-recipient-card__img {
    transform: scale(1.05);
  }
  .dk-recipient-card__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }
  .dk-recipient-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(37,37,37,0.7) 0%, transparent 60%);
  }
  .dk-recipient-card__content {
    position: absolute;
    bottom: 16px;
    left: 12px;
    right: 12px;
    z-index: 2;
  }
  .dk-recipient-card__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: 1.15rem;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
  }
  .dk-recipient-card__tag {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.725rem;
    color: var(--dk-color-gold, #B89552);
    display: block;
    margin-top: 3px;
  }

  @media (max-width: 1024px) {
    .dk-recipient-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--dk-space-md, 1rem);
    }
  }

  @media (max-width: 600px) {
    .dk-recipient-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--dk-space-sm, 0.5rem);
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Shop by Recipient",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "GIFTS FOR YOUR PEOPLE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the Perfect Gift"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Thoughtful, hand-selected pieces for every special relationship."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "recipient_tile",
      "name": "Recipient Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Recipient Title",
          "default": "For Sister"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "Short Tagline",
          "default": "Cherished Gifts"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Recipient Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DELISHA Shop by Recipient",
      "blocks": [
        { "type": "recipient_tile", "settings": { "title": "For Sister" } },
        { "type": "recipient_tile", "settings": { "title": "For Mother" } },
        { "type": "recipient_tile", "settings": { "title": "For Brother" } },
        { "type": "recipient_tile", "settings": { "title": "For Wife" } },
        { "type": "recipient_tile", "settings": { "title": "For Friend" } },
        { "type": "recipient_tile", "settings": { "title": "For Couples" } }
      ]
    }
  ]
}
{% endschema %}
