<section
  id="dk-category-grid-{{ section.id }}"
  class="dk-category-grid-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F9F5EE' }}; padding: {{ section.settings.padding_top | default: 60 }}px 0 {{ section.settings.padding_bottom | default: 60 }}px 0;"
>
  <div class="container">
    {%- if section.settings.subheading != blank or section.settings.heading != blank -%}
      <div class="dk-section-header text-center">
        {%- if section.settings.subheading != blank -%}
          <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="dk-category-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          {%- assign card_title = block.settings.title | default: collection.title | default: 'Category' -%}
          {%- assign card_url = block.settings.link | default: collection.url | default: '#' -%}

          <a href="{{ card_url }}" class="dk-category-tile" {{ block.shopify_attributes }}>
            <div class="dk-category-tile__image-wrap">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="{{ card_title | escape }}"
                  class="dk-category-tile__img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- elsif collection.image != blank -%}
                <img
                  src="{{ collection.image | image_url: width: 600 }}"
                  alt="{{ card_title | escape }}"
                  class="dk-category-tile__img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}{%- assign fallback_img = 'dk-cat-royal-pearl.jpg' -%}
                  {%- when 2 -%}{%- assign fallback_img = 'dk-cat-nazariya.jpg' -%}
                  {%- when 3 -%}{%- assign fallback_img = 'dk-cat-blessed.jpg' -%}
                  {%- when 4 -%}{%- assign fallback_img = 'dk-cat-festive.jpg' -%}
                  {%- when 5 -%}{%- assign fallback_img = 'dk-cat-bhaiya-bhabhi.jpg' -%}
                  {%- else -%}{%- assign fallback_img = 'dk-cat-sets.jpg' -%}
                {%- endcase -%}
                <img
                  src="{{ fallback_img | asset_url }}"
                  alt="{{ card_title | escape }}"
                  class="dk-category-tile__img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}
              <div class="dk-category-tile__overlay"></div>
            </div>

            <div class="dk-category-tile__content">
              <h3 class="dk-category-tile__title">{{ card_title | escape }}</h3>
              {%- if block.settings.subtitle != blank -%}
                <span class="dk-category-tile__subtitle">{{ block.settings.subtitle | escape }}</span>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        <!-- FALLBACK DEFAULT CATEGORY TILES -->
        {%- assign fallback_categories = "RAKHI,TORAN & LATKAN,JEWELLERY,GIFTING,FESTIVE DECOR,KIDS PRODUCTS" | split: "," -%}
        {%- for cat in fallback_categories -%}
          <div class="dk-category-tile">
            <div class="dk-category-tile__image-wrap">
              {{ 'collection-1' | placeholder_svg_tag: 'dk-category-tile__placeholder' }}
              <div class="dk-category-tile__overlay"></div>
            </div>
            <div class="dk-category-tile__content">
              <h3 class="dk-category-tile__title">{{ cat }}</h3>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .dk-section-header {
    margin-bottom: var(--dk-space-xl, 2.5rem);
  }
  .dk-category-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--dk-space-md, 1rem);
  }
  .dk-category-tile {
    display: block;
    position: relative;
    border-radius: var(--dk-radius-md, 8px);
    overflow: hidden;
    text-decoration: none;
    background-color: var(--dk-color-white, #FFFFFF);
    border: 1px solid var(--dk-color-border, rgba(110,31,42,0.12));
    transition: var(--dk-transition, all 0.3s ease);
  }
  .dk-category-tile:hover {
    transform: translateY(-4px);
    box-shadow: var(--dk-shadow-hover, 0 8px 25px rgba(110,31,42,0.09));
    border-color: rgba(110,31,42,0.25);
  }
  .dk-category-tile__image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    overflow: hidden;
    background-color: var(--dk-color-background-secondary, #F2E5DD);
  }
  .dk-category-tile__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .dk-category-tile:hover .dk-category-tile__img {
    transform: scale(1.06);
  }
  .dk-category-tile__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }
  .dk-category-tile__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(37,37,37,0.55) 0%, transparent 60%);
  }
  .dk-category-tile__content {
    position: absolute;
    bottom: 12px;
    left: 10px;
    right: 10px;
    z-index: 2;
    text-align: center;
  }
  .dk-category-tile__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: 0.95rem;
    font-weight: 600;
    color: #FFFFFF;
    margin: 0;
    line-height: 1.2;
    text-shadow: 0 1px 4px rgba(0,0,0,0.4);
  }
  .dk-category-tile__subtitle {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.7rem;
    color: var(--dk-color-gold, #B89552);
    display: block;
    margin-top: 2px;
  }

  @media (max-width: 1024px) {
    .dk-category-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--dk-space-md, 1rem);
    }
  }

  @media (max-width: 600px) {
    .dk-category-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--dk-space-sm, 0.5rem);
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Quick Shop Grid",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Section Subheading",
      "default": "CURATED FOR YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Shop by Category"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F9F5EE"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "category_tile",
      "name": "Category Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle / Tag",
          "default": "Explore"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Shopify Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Category Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Custom Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DELISHA Quick Shop Grid",
      "blocks": [
        { "type": "category_tile", "settings": { "title": "Rakhi" } },
        { "type": "category_tile", "settings": { "title": "Toran & Latkan" } },
        { "type": "category_tile", "settings": { "title": "Jewellery" } },
        { "type": "category_tile", "settings": { "title": "Gifting" } },
        { "type": "category_tile", "settings": { "title": "Festive Decor" } },
        { "type": "category_tile", "settings": { "title": "Kids Products" } }
      ]
    }
  ]
}
{% endschema %}
