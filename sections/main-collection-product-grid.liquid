{%- comment -%} Fonts loaded globally in theme.liquid {%- endcomment -%}

{%- if collection.handle == 'all' -%}
{% render 'all-collections-list' %}
{%- else -%}
<section class="collection-main-section padding-{{ section.id }}" {% if section.settings.full_width
  %}data-full-width="true" {% endif %}>
  <div class="collection-container {% if section.settings.full_width %}full-width{% else %}page-width{% endif %}">

    <!-- MOBILE COMPACT FILTER & SORT BAR (Matches Screenshots) -->
    <div class="mobile-filter-sort-bar">
      {% if section.settings.enable_filtering %}
      <button type="button" class="mobile-filter-trigger" id="MobileFilterOpenBtn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <span>Filter</span>
      </button>
      {% endif %}

      {% if section.settings.enable_sorting %}
      <div class="mobile-sort-trigger-wrap">
        <span>SORT BY</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
        <select id="SortByMobile" class="mobile-sort-select" name="sort_by" form="CollectionFiltersForm" onchange="this.form.submit()">
          {% for option in collection.sort_options %}
            <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
          {% endfor %}
        </select>
      </div>
      {% endif %}
    </div>

    <!-- MOBILE DRAWER BACKDROP OVERLAY -->
    <div class="mobile-filter-overlay" id="MobileFilterOverlay"></div>

    <div class="collection-layout layout-{{ section.settings.filter_layout }}">

      <!-- 1. FILTER SIDEBAR -->
      {% if section.settings.enable_filtering %}
      <aside class="collection-filters" id="CollectionFiltersDrawer">
        <div class="mobile-drawer-header">
          <h3 class="mobile-drawer-title">Filter</h3>
          <button type="button" class="mobile-drawer-close" id="MobileFilterCloseBtn" aria-label="Close Filter">&times;</button>
        </div>

        <div class="filter-header">
          <h2 class="filter-heading">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
              <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
            </svg>
            Filter:
          </h2>
        </div>

        <form class="filter-form" id="CollectionFiltersForm">
          {%- for filter in collection.filters -%}
          <details class="filter-group" open>
            <summary class="filter-group-summary">
              <span>{{ filter.label }}</span>
              <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </summary>

            <div class="filter-group-display">
              {%- case filter.type -%}
              {%- when 'boolean' or 'list' -%}
              <ul class="filter-list">
                {%- for value in filter.values -%}
                <li>
                  <label class="filter-checkbox {% if value.count == 0 and value.active == false %}disabled{% endif %}">
                              <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                              <span class="custom-checkbox"></span>
                              {{ value.label }}
                            </label>
                </li>
                {%- endfor -%}
              </ul>

              {%- when 'price_range' -%}
              <div class="price-range">
                <p class="price-highest">The highest price is {{ filter.range_max | money }}</p>
                <div class="price-slider-group">
                  <div class="field">
                    <span>₹</span>
                    <input type="number" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="0" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                  </div>
                  <span class="delimiter">-</span>
                  <div class="field">
                    <span>₹</span>
                    <input type="number" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}" min="0" max="{{ filter.range_max | money_without_currency | replace: ',', '' }}">
                  </div>
                </div>
              </div>
              {%- endcase -%}
            </div>
          </details>
          {%- endfor -%}

          <div class="mobile-drawer-footer">
            <button type="button" class="mobile-apply-btn" id="MobileFilterApplyBtn">APPLY FILTERS</button>
          </div>
        </form>
      </aside>
      {% endif %}

      <!-- 2. PRODUCT GRID AREA -->
      <div class="collection-grid-wrapper">

        <!-- TOOLBAR -->
        <div class="collection-toolbar">
          <div class="toolbar-left">
            <p class="product-count">
              Showing 1-{{ collection.products.size }} of {{ collection.products_count }} Results
            </p>
          </div>

          <div class="toolbar-right">
            <!-- View Icons -->
            <div class="grid-view-toggles desktop-only">
              <button class="view-btn" data-col="2"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="7" height="18"/><rect x="14" y="3" width="7" height="18"/></svg></button>
              <button class="view-btn active" data-col="3"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="3" width="5" height="18"/><rect x="9.5" y="3" width="5" height="18"/><rect x="17" y="3" width="5" height="18"/></svg></button>
              <button class="view-btn" data-col="4"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="2" y="3" width="3.5" height="18"/><rect x="7.5" y="3" width="3.5" height="18"/><rect x="13" y="3" width="3.5" height="18"/><rect x="18.5" y="3" width="3.5" height="18"/></svg></button>
              <button class="view-btn" data-col="1"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="4" width="18" height="4"/><rect x="3" y="10" width="18" height="4"/><rect x="3" y="16" width="18" height="4"/></svg></button>
            </div>

            {% if section.settings.enable_sorting %}
            <div class="collection-sort">
              <select id="SortBy" name="sort_by" form="CollectionFiltersForm" onchange="this.form.submit()">
                  {% for option in collection.sort_options %}
                    <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>
                  {% endfor %}
                </select>
            </div>
            {% endif %}
          </div>
        </div>

        <!-- GRID -->
        {% paginate collection.products by section.settings.products_per_page %}
        <div class="product-grid grid-cols-{{ section.settings.columns_desktop }}" id="ProductGrid">
          {% for product in collection.products %}
          <div class="grid-item">
            {% render 'product-card', product: product, show_vendor: section.settings.show_vendor, image_ratio:
            section.settings.image_ratio, show_secondary_image: section.settings.show_second_image, show_rating:
            section.settings.show_rating, show_new_tag: section.settings.show_new_tag %}
          </div>
          {% else %}
            {%- comment -%} REAL CATALOG SHOWCASE FALLBACK {%- endcomment -%}
            {%- assign fallback_titles = "Mayur Nazar Trio|Shree Ganesh Rakhi Trio|Emerald Noor Pearl Set|Rangrez Designer Duo|Nazar Noor Bhaiya Bhabhi Set|Shri Radha Krishna Trio|Krishna Bansuri Lumba Set|Shubh Kundan Rakhi Duo|Emerald Pearl Rakhi Set|Ruby Panna Pearl Lumba|Neelam Pearl Rakhi Set|Shree Gajraj Rakhi Set" | split: "|" -%}
            {%- assign fallback_prices = "₹599.00|₹899.00|₹899.00|₹599.00|₹999.00|₹699.00|₹999.00|₹599.00|₹899.00|₹899.00|₹899.00|₹999.00" | split: "|" -%}
            {%- assign fallback_compares = "₹899.00|₹1,299.00|₹1,299.00|₹899.00|₹1,499.00|₹999.00|₹1,499.00|₹899.00|₹1,299.00|₹1,299.00|₹1,299.00|₹1,499.00" | split: "|" -%}
            {%- assign fallback_imgs = "dk-cat-nazariya.jpg|dk-cat-blessed.jpg|dk-cat-royal-pearl.jpg|dk-cat-festive.jpg|dk-cat-bhaiya-bhabhi.jpg|dk-cat-sets.jpg|dk-rec-couples.jpg|dk-rec-brother.jpg|dk-soc-2.jpg|dk-soc-3.jpg|dk-soc-4.jpg|dk-soc-5.jpg" | split: "|" -%}
            
            {%- for i in (0..11) -%}
              {%- assign p_title = fallback_titles[i] -%}
              {%- assign p_price = fallback_prices[i] -%}
              {%- assign p_compare = fallback_compares[i] -%}
              {%- assign p_img = fallback_imgs[i] -%}

              <div class="grid-item">
                <div class="dk-product-card">
                  <div class="dk-product-card__media">
                    <a href="{{ routes.all_products_collection_url }}" class="dk-product-card__image-link" aria-label="{{ p_title | escape }}">
                      <img
                        src="{{ p_img | asset_url }}"
                        alt="{{ p_title | escape }}"
                        class="dk-product-card__img dk-product-card__img--primary"
                        loading="lazy"
                        width="600"
                        height="600"
                      >
                    </a>
                    <div class="dk-product-card__badges">
                      <span class="dk-badge dk-badge--sale">FESTIVE EDIT</span>
                    </div>
                    <button
                      type="button"
                      class="dk-product-card__wishlist-btn"
                      aria-label="Add {{ p_title | escape }} to wishlist"
                    >
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
                      </svg>
                    </button>
                  </div>
                  <div class="dk-product-card__info">
                    <h3 class="dk-product-card__title">
                      <a href="{{ routes.all_products_collection_url }}">{{ p_title }}</a>
                    </h3>
                    <div class="dk-product-card__price">
                      <span class="dk-product-card__price-current dk-product-card__price--sale">{{ p_price }}</span>
                      <s class="dk-product-card__price-compare">{{ p_compare }}</s>
                    </div>
                    <a href="{{ routes.all_products_collection_url }}" class="dk-product-card__add-btn" style="display: block; text-decoration: none; text-align: center;">
                      View Product
                    </a>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          {% endfor %}
        </div>

        {% if paginate.pages > 1 %}
        {% render 'pagination', paginate: paginate %}
        {% endif %}
        {% endpaginate %}

      </div>
    </div>
  </div>
</section>
{%- endif -%}

<style>
  /* Base Setup */
  .collection-main-section {
    font-family: var(--font-body, 'Poppins', sans-serif);
    color: #111;

    padding-top: {
        {
        section.settings.padding_top
      }
    }

    px;

    padding-bottom: {
        {
        section.settings.padding_bottom
      }
    }

    px;
  }

  .collection-container {
    margin: 0 auto;
  }

  .page-width {
    width: 90%;
    max-width: 1400px;
  }

  .full-width {
    width: 100%;
    padding: 0 40px;
  }

  /* Layout */
  .collection-layout {
    display: flex;
    gap: 40px;
  }

  .collection-layout.layout-vertical .collection-filters {
    flex: 0 0 260px;
    border-right: 1px solid #f0f0f0;
    padding-right: 20px;
  }

  .collection-layout.layout-vertical .collection-grid-wrapper {
    flex: 1;
    min-width: 0;
  }

  /* Sidebar Filters */
  .filter-header {
    margin-bottom: 25px;
  }

  .filter-heading {
    font-size: 18px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
  }

  .filter-group {
    border-bottom: 1px solid #f0f0f0;
    padding: 18px 0;
  }

  .filter-group-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .filter-group-summary::-webkit-details-marker {
    display: none;
  }

  .filter-group[open] .filter-group-summary svg {
    transform: rotate(180deg);
  }

  .filter-group-display {
    margin-top: 15px;
  }

  .filter-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .filter-list li {
    margin-bottom: 10px;
  }

  .filter-checkbox {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: #444;
    cursor: pointer;
  }

  .filter-checkbox input {
    display: none;
  }

  .custom-checkbox {
    width: 18px;
    height: 18px;
    border: 1px solid #ddd;
    border-radius: 4px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .filter-checkbox input:checked+.custom-checkbox {
    background: #333;
    border-color: #333;
  }

  .filter-checkbox input:checked+.custom-checkbox::after {
    content: '';
    width: 10px;
    height: 5px;
    border-bottom: 2px solid #fff;
    border-left: 2px solid #fff;
    transform: rotate(-45deg);
    margin-bottom: 2px;
  }

  .filter-checkbox.disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Price Range */
  .price-highest {
    font-size: 13px;
    color: #666;
    margin-bottom: 15px;
  }

  .price-slider-group {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .price-slider-group .field {
    display: flex;
    align-items: center;
    border: 1px solid #ddd;
    border-radius: 6px;
    padding: 5px 10px;
    background: #fdfdfd;
  }

  .price-slider-group input {
    border: none;
    width: 60px;
    outline: none;
    font-family: inherit;
    font-size: 14px;
    padding: 5px;
    background: transparent;
  }

  .delimiter {
    color: #999;
  }

  /* Toolbar */
  .collection-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 30px;
    border-bottom: 1px solid #f0f0f0;
    padding-bottom: 15px;
  }

  .product-count {
    font-size: 14px;
    color: #555;
    margin: 0;
  }

  .toolbar-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .grid-view-toggles {
    display: flex;
    gap: 8px;
  }

  .view-btn {
    background: transparent;
    border: none;
    cursor: pointer;
    color: #aaa;
    padding: 5px;
    transition: color 0.2s;
  }

  .view-btn.active,
  .view-btn:hover {
    color: #111;
  }

  .collection-sort select {
    padding: 8px 30px 8px 10px;
    border: none;
    background: transparent;
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    appearance: none;
    background-image: url('data:image/svg+xml;utf8,<svg viewBox="0 0 24 24" width="16" height="16" stroke="black" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>');
    background-repeat: no-repeat;
    background-position: right center;
    outline: none;
  }

  /* Product Grid */
  .product-grid {
    display: grid;
    gap: 25px;
  }

  .grid-cols-2 {
    grid-template-columns: repeat(2, 1fr);
  }

  .grid-cols-3 {
    grid-template-columns: repeat(3, 1fr);
  }

  .grid-cols-4 {
    grid-template-columns: repeat(4, 1fr);
  }

  .grid-cols-1 {
    grid-template-columns: 1fr;
  }

  /* Pagination */
  .pagination-wrapper {
    margin-top: 50px;
    text-align: center;
    border-top: 1px solid #eee;
    padding-top: 30px;
    width: 100%;
  }

  .pagination-wrapper .pagination,
  .pagination-wrapper ul {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
    list-style: none !important;
    list-style-type: none !important;
    padding: 0 !important;
    margin: 0 auto !important;
  }

  .pagination-wrapper .pagination li,
  .pagination-wrapper ul li {
    list-style: none !important;
    list-style-type: none !important;
    display: inline-flex !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .pagination-wrapper span,
  .pagination-wrapper a,
  .pagination-wrapper li a,
  .pagination-wrapper li span {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    min-width: 38px !important;
    height: 38px !important;
    padding: 0 10px !important;
    border-radius: 4px !important;
    text-decoration: none !important;
    color: #333 !important;
    background: #ffffff !important;
    border: 1px solid #ddd !important;
    font-size: 14px !important;
    font-weight: 500 !important;
  }

  .pagination-wrapper span.current,
  .pagination-wrapper li.current span,
  .pagination-wrapper li.current a {
    background: #333 !important;
    color: #fff !important;
    border-color: #333 !important;
    font-weight: 600 !important;
  }

  .pagination-wrapper a:hover,
  .pagination-wrapper li a:hover {
    background: #f0f0f0 !important;
  }

  /* Responsive & Mobile Filter Bar */
  .mobile-filter-sort-bar {
    display: none;
    border: 1px solid #e2e2e2;
    border-radius: 4px;
    background: #ffffff;
    margin-bottom: 20px;
    width: 100%;
    box-sizing: border-box;
  }

  @media(max-width: 991px) {
    .mobile-filter-sort-bar {
      display: flex;
      align-items: center;
    }

    .mobile-filter-trigger {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 12px 15px;
      background: transparent;
      border: none;
      border-right: 1px solid #e2e2e2;
      font-family: var(--font-body, 'Poppins', sans-serif);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.5px;
      color: #333333;
      cursor: pointer;
      text-transform: uppercase;
    }

    .mobile-sort-trigger-wrap {
      flex: 1;
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 12px 15px;
      font-family: var(--font-body, 'Poppins', sans-serif);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.5px;
      color: #333333;
      cursor: pointer;
      text-transform: uppercase;
    }

    .mobile-sort-select {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      opacity: 0;
      cursor: pointer;
      -webkit-appearance: none;
    }

    /* Hide desktop filter sidebar in layout flow */
    .collection-layout {
      flex-direction: column;
    }

    .desktop-only,
    .collection-toolbar .collection-sort {
      display: none !important;
    }

    .collection-toolbar {
      margin-bottom: 15px;
      padding-bottom: 10px;
      border-bottom: none;
    }

    /* Mobile Drawer Overlay */
    .mobile-filter-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: 9998;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .mobile-filter-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    /* Mobile Slide-Over Drawer for Filters */
    .collection-filters {
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      width: 85%;
      max-width: 340px;
      height: 100vh;
      background: #fdfaf5;
      z-index: 9999;
      transform: translateX(-100%);
      transition: transform 0.3s ease;
      box-shadow: 4px 0 25px rgba(0, 0, 0, 0.15);
      display: flex;
      flex-direction: column;
      padding: 0 !important;
      overflow: hidden;
      border-right: none;
    }

    .collection-filters.open {
      transform: translateX(0);
    }

    .mobile-drawer-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px;
      border-bottom: 1px solid #e5e5e5;
      background: #ffffff;
    }

    .mobile-drawer-title {
      font-family: var(--font-heading, 'Playfair Display', serif);
      font-size: 20px;
      font-weight: 600;
      margin: 0;
      color: #111;
    }

    .mobile-drawer-close {
      background: transparent;
      border: none;
      font-size: 28px;
      line-height: 1;
      color: #333;
      cursor: pointer;
      padding: 0 5px;
    }

    .filter-header {
      display: none;
    }

    .filter-form {
      flex: 1;
      overflow-y: auto;
      padding: 15px 20px 80px 20px;
    }

    .mobile-drawer-footer {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      padding: 15px 20px;
      background: #ffffff;
      border-top: 1px solid #e5e5e5;
    }

    .mobile-apply-btn {
      width: 100%;
      background: #333333;
      color: #ffffff;
      border: none;
      padding: 12px;
      border-radius: 4px;
      font-family: var(--font-body, 'Poppins', sans-serif);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 1px;
      cursor: pointer;
    }
  }

  @media(min-width: 992px) {

    .mobile-drawer-header,
    .mobile-drawer-footer,
    .mobile-filter-overlay {
      display: none !important;
    }
  }

  @media(max-width: 768px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 15px;
    }
  }
</style>

<script>
  // Simple form auto-submit for filters
  document.querySelectorAll('#CollectionFiltersForm input[type="checkbox"]').forEach(checkbox => {
    checkbox.addEventListener('change', () => {
      document.getElementById('CollectionFiltersForm').submit();
    });
  });

  // Simple grid view toggler
  document.querySelectorAll('.view-btn').forEach(btn => {
    btn.addEventListener('click', function() {
      document.querySelectorAll('.view-btn').forEach(b => b.classList.remove('active'));
      this.classList.add('active');
      const cols = this.getAttribute('data-col');
      const grid = document.getElementById('ProductGrid');
      grid.className = 'product-grid grid-cols-' + cols;
    });
  });

  // Mobile Filter Drawer Toggler
  const openFilterBtn = document.getElementById('MobileFilterOpenBtn');
  const closeFilterBtn = document.getElementById('MobileFilterCloseBtn');
  const applyFilterBtn = document.getElementById('MobileFilterApplyBtn');
  const filterOverlay = document.getElementById('MobileFilterOverlay');
  const filterDrawer = document.getElementById('CollectionFiltersDrawer');

  function openMobileFilterDrawer() {
    if (filterDrawer) filterDrawer.classList.add('open');
    if (filterOverlay) filterOverlay.classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeMobileFilterDrawer() {
    if (filterDrawer) filterDrawer.classList.remove('open');
    if (filterOverlay) filterOverlay.classList.remove('active');
    document.body.style.overflow = '';
  }

  if (openFilterBtn) openFilterBtn.addEventListener('click', openMobileFilterDrawer);
  if (closeFilterBtn) closeFilterBtn.addEventListener('click', closeMobileFilterDrawer);
  if (applyFilterBtn) applyFilterBtn.addEventListener('click', closeMobileFilterDrawer);
  if (filterOverlay) filterOverlay.addEventListener('click', closeMobileFilterDrawer);
</script>

