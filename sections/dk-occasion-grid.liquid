<section
  id="dk-occasion-grid-{{ section.id }}"
  class="dk-occasion-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F2E5DD' }}; padding: {{ section.settings.padding_top | default: 70 }}px 0 {{ section.settings.padding_bottom | default: 70 }}px 0;"
>
  <div class="container">
    <div class="dk-section-header text-center">
      {%- if section.settings.subheading != blank -%}
        <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="dk-description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
    </div>

    <div class="dk-occasion-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- assign card_title = block.settings.title | default: 'Occasion' -%}
          {%- assign card_url = block.settings.link | default: routes.all_products_collection_url -%}

          <a href="{{ card_url }}" class="dk-occasion-card" {{ block.shopify_attributes }}>
            <div class="dk-occasion-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  alt="{{ card_title | escape }}"
                  class="dk-occasion-card__img"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}{%- assign fallback_img = 'dk-hero-banner-1.jpg' -%}
                  {%- when 2 -%}{%- assign fallback_img = 'dk-hero-banner-2.jpg' -%}
                  {%- when 3 -%}{%- assign fallback_img = 'dk-hero-banner-3.jpg' -%}
                  {%- when 4 -%}{%- assign fallback_img = 'dk-cat-blessed.jpg' -%}
                  {%- when 5 -%}{%- assign fallback_img = 'dk-cat-festive.jpg' -%}
                  {%- else -%}{%- assign fallback_img = 'dk-cat-royal-pearl.jpg' -%}
                {%- endcase -%}
                <img
                  src="{{ fallback_img | asset_url }}"
                  alt="{{ card_title | escape }}"
                  class="dk-occasion-card__img"
                  loading="lazy"
                  width="800"
                  height="1000"
                >
              {%- endif -%}
              <div class="dk-occasion-card__overlay"></div>
            </div>

            <div class="dk-occasion-card__content">
              <h3 class="dk-occasion-card__title">{{ card_title | escape }}</h3>
              {%- if block.settings.description != blank -%}
                <p class="dk-occasion-card__desc">{{ block.settings.description | escape }}</p>
              {%- endif -%}
              <span class="dk-occasion-card__btn">EXPLORE GIFTS &rarr;</span>
            </div>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- assign fallback_occasions = "Birthday,Wedding,Rakhi,Festive,Housewarming,Just Because" | split: "," -%}
        {%- for occ in fallback_occasions -%}
          <div class="dk-occasion-card">
            <div class="dk-occasion-card__media">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'dk-occasion-card__placeholder' }}
              <div class="dk-occasion-card__overlay"></div>
            </div>
            <div class="dk-occasion-card__content">
              <h3 class="dk-occasion-card__title">{{ occ }}</h3>
              <p class="dk-occasion-card__desc">Handcrafted gifts made for this special moment.</p>
              <span class="dk-occasion-card__btn">EXPLORE GIFTS &rarr;</span>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .dk-occasion-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--dk-space-lg, 1.5rem);
  }
  .dk-occasion-card {
    display: block;
    position: relative;
    border-radius: var(--dk-radius-md, 8px);
    overflow: hidden;
    text-decoration: none;
    background-color: #FFFFFF;
    box-shadow: 0 4px 15px rgba(0,0,0,0.04);
    transition: var(--dk-transition, all 0.3s ease);
  }
  .dk-occasion-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(110,31,42,0.12);
  }
  .dk-occasion-card__media {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    overflow: hidden;
    background-color: var(--dk-color-background, #F9F5EE);
  }
  .dk-occasion-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .dk-occasion-card:hover .dk-occasion-card__img {
    transform: scale(1.05);
  }
  .dk-occasion-card__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }
  .dk-occasion-card__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(37,37,37,0.75) 0%, rgba(37,37,37,0.1) 60%);
  }
  .dk-occasion-card__content {
    position: absolute;
    bottom: 20px;
    left: 20px;
    right: 20px;
    z-index: 2;
    color: #FFFFFF;
  }
  .dk-occasion-card__title {
    font-family: var(--dk-font-heading, 'Playfair Display', serif);
    font-size: clamp(1.2rem, 2vw, 1.5rem);
    font-weight: 600;
    color: #FFFFFF;
    margin-bottom: 6px;
  }
  .dk-occasion-card__desc {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.825rem;
    color: rgba(255,255,255,0.85);
    margin-bottom: 12px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .dk-occasion-card__btn {
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 1.5px;
    color: var(--dk-color-gold, #B89552);
    text-transform: uppercase;
    transition: color 0.2s ease;
  }
  .dk-occasion-card:hover .dk-occasion-card__btn {
    color: #FFFFFF;
  }

  @media (max-width: 900px) {
    .dk-occasion-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--dk-space-md, 1rem);
    }
  }

  @media (max-width: 500px) {
    .dk-occasion-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--dk-space-sm, 0.5rem);
    }
    .dk-occasion-card__content {
      bottom: 12px;
      left: 12px;
      right: 12px;
    }
    .dk-occasion-card__desc {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Shop by Occasion",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CELEBRATE EVERY MOMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Occasion"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Find thoughtfully curated handcrafted gifts for birthdays, weddings, festive celebrations and more."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2E5DD"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "occasion_tile",
      "name": "Occasion Tile",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Occasion Title",
          "default": "Birthday"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Short Description",
          "default": "Artisanal gifts crafted to make their day unforgettable."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Occasion Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Tile Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DELISHA Shop by Occasion",
      "blocks": [
        { "type": "occasion_tile", "settings": { "title": "Birthday" } },
        { "type": "occasion_tile", "settings": { "title": "Wedding" } },
        { "type": "occasion_tile", "settings": { "title": "Rakhi Special" } },
        { "type": "occasion_tile", "settings": { "title": "Festive Edit" } },
        { "type": "occasion_tile", "settings": { "title": "Housewarming" } },
        { "type": "occasion_tile", "settings": { "title": "Just Because" } }
      ]
    }
  ]
}
{% endschema %}
