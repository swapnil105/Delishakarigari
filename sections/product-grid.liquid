<div class="product-grid-section" style="padding: 60px 0;">
  <div class="container">
    <h1 class="section-title">{{ collection.title | default: 'Products' }}</h1>
    <div class="collection-grid" style="grid-template-columns: repeat(4, 1fr);">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p>No products found.</p>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product Grid",
  "settings": []
}
{% endschema %}
