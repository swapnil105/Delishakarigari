<div class="wishlist-overlay" id="WishlistOverlay"></div>
<div class="wishlist-drawer" id="WishlistDrawer">
  <div class="wishlist-drawer-header">
    <h3>Your Wishlist</h3>
    <button class="wishlist-close" id="WishlistClose">&times;</button>
  </div>

  <div class="wishlist-drawer-body" id="WishlistItems">
    <!-- Wishlist items will be rendered here by JS -->
    <div class="wishlist-empty" style="display: none;">
      <p>Your wishlist is currently empty.</p>
      <a href="{{ routes.all_products_collection_url }}" class="btn"
        style="margin-top:15px; display:inline-block; padding:10px 20px; background:#000; color:#fff; text-decoration:none;">Continue
        Shopping</a>
    </div>
    <div class="wishlist-loading" style="display: none; text-align: center; padding: 20px;">
      <p>Loading...</p>
    </div>
  </div>
</div>

<style>
  .wishlist-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.5);
    z-index: 100000;
    opacity: 0;
    visibility: hidden;
    transition: 0.3s;
  }

  .wishlist-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .wishlist-drawer {
    position: fixed;
    top: 0;
    right: -400px;
    width: 400px;
    max-width: 90vw;
    height: 100vh;
    background: #fff;
    z-index: 100001;
    transition: right 0.4s ease;
    display: flex;
    flex-direction: column;
    box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
  }

  .wishlist-drawer.active {
    right: 0;
  }

  .wishlist-drawer-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid #eee;
  }

  .wishlist-drawer-header h3 {
    margin: 0;
    font-size: 20px;
    font-family: 'Playfair Display', serif;
  }

  .wishlist-close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
  }

  .wishlist-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  .wishlist-item {
    display: flex;
    gap: 15px;
    margin-bottom: 20px;
    padding-bottom: 20px;
    border-bottom: 1px solid #f5f5f5;
  }

  .wishlist-item-img {
    width: 80px;
    height: 100px;
    object-fit: cover;
    border-radius: 4px;
  }

  .wishlist-item-details {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  .wishlist-item-title {
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    color: #333;
    margin-bottom: 5px;
    display: block;
  }

  .wishlist-item-price {
    color: #caa25d;
    font-weight: bold;
    font-size: 14px;
  }

  .wishlist-item-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 10px;
  }

  .wishlist-remove {
    background: none;
    border: none;
    color: #999;
    text-decoration: underline;
    cursor: pointer;
    font-size: 13px;
    padding: 0;
  }

  .wishlist-add-to-cart {
    background: #000;
    color: #fff;
    border: none;
    padding: 6px 12px;
    font-size: 12px;
    cursor: pointer;
    border-radius: 4px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .wishlist-empty {
    text-align: center;
    padding: 40px 20px;
    color: #666;
  }
</style>

{% schema %}
{
"name": "Wishlist Drawer",
"settings": [],
"presets": [
{
"name": "Wishlist Drawer"
}
]
}
{% endschema %}