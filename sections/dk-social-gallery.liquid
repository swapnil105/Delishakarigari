<section
  id="dk-social-gallery-{{ section.id }}"
  class="dk-social-sec"
  style="background-color: {{ section.settings.bg_color | default: '#F2E5DD' }}; padding: {{ section.settings.padding_top | default: 70 }}px 0 {{ section.settings.padding_bottom | default: 70 }}px 0;"
>
  <div class="container">
    <div class="dk-section-header text-center">
      {%- if section.settings.subheading != blank -%}
        <span class="dk-subtitle">{{ section.settings.subheading | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="dk-heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.instagram_handle != blank -%}
        <a href="https://instagram.com/{{ section.settings.instagram_handle | remove: '@' }}" target="_blank" rel="noopener" class="dk-social-handle">
          @{{ section.settings.instagram_handle | remove: '@' }}
        </a>
      {%- endif -%}
    </div>

    <div class="dk-social-grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="dk-social-card" {{ block.shopify_attributes }}>
            <div class="dk-social-card__media">
              {%- if block.settings.image != blank -%}
                <img
                  src="{{ block.settings.image | image_url: width: 600 }}"
                  alt="DELISHA Karigari Social Photo"
                  class="dk-social-card__img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- else -%}
                {%- case forloop.index -%}
                  {%- when 1 -%}{%- assign fallback_img = 'dk-soc-1.jpg' -%}
                  {%- when 2 -%}{%- assign fallback_img = 'dk-soc-2.jpg' -%}
                  {%- when 3 -%}{%- assign fallback_img = 'dk-soc-3.jpg' -%}
                  {%- when 4 -%}{%- assign fallback_img = 'dk-soc-4.jpg' -%}
                  {%- when 5 -%}{%- assign fallback_img = 'dk-soc-5.jpg' -%}
                  {%- else -%}{%- assign fallback_img = 'dk-soc-6.jpg' -%}
                {%- endcase -%}
                <img
                  src="{{ fallback_img | asset_url }}"
                  alt="DELISHA Karigari Social Photo"
                  class="dk-social-card__img"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {%- endif -%}
              <a href="{{ block.settings.link | default: '#' }}" target="_blank" rel="noopener" class="dk-social-card__overlay" aria-label="View Instagram Post">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </a>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..6) -%}
          <div class="dk-social-card">
            <div class="dk-social-card__media">
              {{ 'lifestyle-1' | placeholder_svg_tag: 'dk-social-card__placeholder' }}
              <div class="dk-social-card__overlay">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .dk-social-handle {
    display: inline-block;
    font-family: var(--dk-font-body, 'Poppins', sans-serif);
    font-size: 0.9rem;
    color: var(--dk-color-primary, #6E1F2A);
    font-weight: 500;
    text-decoration: none;
    margin-top: 4px;
    letter-spacing: 1px;
  }
  .dk-social-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: var(--dk-space-md, 1rem);
  }
  .dk-social-card {
    position: relative;
    border-radius: var(--dk-radius-md, 8px);
    overflow: hidden;
  }
  .dk-social-card__media {
    position: relative;
    aspect-ratio: 1 / 1;
    width: 100%;
    background-color: var(--dk-color-background, #F9F5EE);
  }
  .dk-social-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .dk-social-card:hover .dk-social-card__img {
    transform: scale(1.08);
  }
  .dk-social-card__placeholder {
    width: 100%;
    height: 100%;
    opacity: 0.35;
  }
  .dk-social-card__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(110,31,42,0.65);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #FFFFFF;
    opacity: 0;
    transition: opacity 0.3s ease;
    text-decoration: none;
  }
  .dk-social-card:hover .dk-social-card__overlay {
    opacity: 1;
  }

  @media (max-width: 1024px) {
    .dk-social-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 600px) {
    .dk-social-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
  }
</style>

{% schema %}
{
  "name": "DELISHA Social Gallery",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "CELEBRATE WITH US"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow Our Karigari"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Handle",
      "default": "delishakarigari"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#F2E5DD"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Top",
      "default": 70
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 70
    }
  ],
  "blocks": [
    {
      "type": "social_image",
      "name": "Social Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Post Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "DELISHA Social Gallery",
      "blocks": [
        { "type": "social_image" },
        { "type": "social_image" },
        { "type": "social_image" },
        { "type": "social_image" },
        { "type": "social_image" },
        { "type": "social_image" }
      ]
    }
  ]
}
{% endschema %}
